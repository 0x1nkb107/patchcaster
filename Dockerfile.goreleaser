# Release image (ADR-015): pure COPY so buildx can build each architecture
# without emulating any target binary — no RUN, no QEMU. goreleaser stages
# the binaries under linux/<arch>/ and buildx resolves TARGETPLATFORM per
# platform; the dev flow keeps using the self-building Dockerfile.
#
# The base digest must match the dev Dockerfile's distroless stage by hand
# (ADR-015 consequence: the two files can drift; the CI smoke job is the
# alarm).
ARG BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:60f7c00d922b1e111553eded253651fef5b5338950573754716c562acde64950
FROM ${BASE_IMAGE}

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/* /usr/local/bin/

ENTRYPOINT ["/usr/local/bin/patchcaster"]
